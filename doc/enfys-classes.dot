#!/usr/bin/env -S jinjacat
---
# See https://github.com/gw1urf/jinjacat for how this gets processed
# to a diagram.
#
# Special case - if your frontmatter contains a "pipe" key,
# then jinjacat will pass its output through the supplied
# shell command.
#
# jinjacat will also set "stdout" to its sys.stdout file descriptor.
# With expansion of jinja in frontmatter tags, this lets you detect
# whether you're sending to a terminal and modify the pipe command.
postproc: unflatten | dot -Tpng
display: feh --scale-down -g 2560x720 -Z -
pipe: "{{ postproc }}{% if stdout.isatty() %} | {{display}}{% endif %}"

calibration: cyan
science_data: yellow
processed_eb_hk: orange
processed_ob_hk: darkorange
raw_eb: seagreen
raw_ob: darkseagreen
uses: green
contains: red
instance: blue
---
{% macro node(node_name, done=False) %}
{{ node_name }} [ label="{{node_name}}"{% if not done %} fontcolor="red"{% endif %} ]
{% endmacro %}
digraph classes {
    graph [ dpi=300 ];
    size = "8x12";
    newrank=true;
    layout=dot;

    rankdir=BT

    subgraph top {
        rank = same;
        {{ node("BitstructTemplateClass", done=True) }};
        {{ node("dataclass", done=True) }};
    }

    subgraph cluster_calibration {
        node [fillcolor="{{calibration}}", style=filled];
        style=invis;

        subgraph calbase {
            rank=same;
            {{node("EbCalibration", done=True)}};
            {{node("ObCalibration", done=True)}};
        }
        subgraph calsub {
            rank=same;
            {{node("eb_calibration_em", done=True)}};
            {{node("ob_calibration_bb2", done=True)}};
            {{node("ob_calibration_em", done=True)}};
        }
    }

    subgraph sciencedata {
        cluster=true;
        style=invis;
        node [fillcolor="{{science_data}}", style=filled];
        {{node("ScienceRow", done=True)}};
        {{node("TimestampedScienceRow", done=True)}};
        {{node("ProcessedScienceRow", done=True)}};
        {{node("ScienceDataSet")}};
    }

    subgraph ebhkdata {
        node [fillcolor="{{processed_eb_hk}}", style=filled];
        cluster=true;
        style=invis;
        {{node("TimestampedEbHk", done=True)}};
        {{node("ProcessedEbHk")}};
        {{node("EbHkDataSet")}};
    }

    subgraph obhkdata {
        cluster=true;
        style=invis;
        node [fillcolor="{{processed_ob_hk}}", style=filled];
        {{node("TimestampedObHk", done=True)}};
        {{node("ProcessedObHk", done=True)}};
        {{node("ObHkDataSet")}};
    }

    subgraph OB {
        cluster=true;
        style=invis;
        node [fillcolor="{{raw_ob}}", style=filled];
        {{node("ObTmPacket", done=True)}};
        {{node("ObHkPacket", done=True)}};
        {{node("ObScienceDataPacket", done=True)}};
        {{node("ObAckPacket", done=True)}};
        {{node("ObNackPacket", done=True)}};
    }

    subgraph EB {
        cluster=true;
        style=invis;
        node [fillcolor="{{raw_eb}}", style=filled];
        {{node("EbTmHeader", done=True)}};
        {{node("EbScienceRow", done=True)}};

        {{node("EbTmPacket", done=True)}};

        {{node("EbHkPacket", done=True)}};
        {{node("EbPostHkPacket", done=True)}};

        {{node("EbRegularHkPacket", done=True)}};
        {{node("EbResponseHkPacket", done=True)}};

        {{node("EbDumpDataPacket", done=True)}};

        {{node("EbScienceDataPacket", done=True)}};
        {{node("EbScienceDataCPacket", done=True)}};
        {{node("EbScienceDataNcPacket", done=True)}};
    }

    // Calibration data for the various instruments.
    EbCalibration -> dataclass;
    eb_calibration_em -> EbCalibration [color={{instance}}];

    ObCalibration -> dataclass;
    ob_calibration_bb2 -> ObCalibration [color={{instance}}];
    ob_calibration_em -> ObCalibration [color={{instance}}];

    // Collections of processed data.

    // OB HK data.
    TimestampedObHk -> ObHkPacket;
    ProcessedObHk -> TimestampedObHk;
    ObHkDataSet -> ProcessedObHk [color={{contains}}];
    ObHkDataSet -> ProcessedObHk [color={{contains}}];
    ObHkDataSet -> ProcessedObHk [color={{contains}}];
    ProcessedObHk -> { ob_calibration_bb2, ob_calibration_em } [color={{uses}}];

    // EB HK data.
    EbHkDataSet -> ProcessedEbHk [color={{contains}}];
    EbHkDataSet -> ProcessedEbHk [color={{contains}}];
    EbHkDataSet -> ProcessedEbHk [color={{contains}}];
    TimestampedEbHk -> EbHkPacket;
    TimestampedEbHk -> { EbResponseHkPacket, EbRegularHkPacket } [color={{uses}}];
    ProcessedEbHk -> TimestampedEbHk;
    ProcessedEbHk -> ProcessedObHk [color={{contains}}];
    ProcessedEbHk -> { eb_calibration_em, ob_calibration_bb2, ob_calibration_em } [color={{uses}}];

    // OB or EB science data.
    ScienceRow-> dataclass;
    ScienceRow-> { EbScienceRow, ObScienceDataPacket } [color={{uses}}];
    ScienceDataSet -> ProcessedScienceRow [color={{contains}}];
    ScienceDataSet -> ProcessedScienceRow [color={{contains}}];
    ScienceDataSet -> ProcessedScienceRow [color={{contains}}];
    TimestampedScienceRow -> ScienceRow;
    ProcessedScienceRow -> TimestampedScienceRow;
    ProcessedScienceRow -> { ob_calibration_bb2, ob_calibration_em } [color={{uses}}];

    // Serial packets from the OB.
    ObTmPacket -> BitstructTemplateClass
    ObScienceDataPacket -> ObTmPacket;
    ObHkPacket -> ObTmPacket;
    ObAckPacket -> ObTmPacket;
    ObNackPacket -> ObTmPacket;


    // Serial packets from the EB.
    EbTmHeader->BitstructTemplateClass;
    EbTmPacket->BitstructTemplateClass;
    EbScienceRow->BitstructTemplateClass;

    EbHkPacket -> EbTmPacket;
    EbPostHkPacket -> EbTmPacket;
    EbDumpDataPacket -> EbTmPacket;
    EbScienceDataPacket -> EbTmPacket;
    EbScienceDataPacket -> EbScienceRow [color={{contains}}];
    EbScienceDataPacket -> EbScienceRow [color={{contains}}];
    EbScienceDataPacket -> EbScienceRow [color={{contains}}];
    EbTmPacket -> EbTmHeader [color={{contains}}];
    EbHkPacket -> ObHkPacket [color={{contains}}];

    EbRegularHkPacket -> EbHkPacket;
    EbResponseHkPacket -> EbHkPacket;

    EbScienceDataCPacket -> EbScienceDataPacket;
    EbScienceDataNcPacket -> EbScienceDataPacket;

    subgraph key {
        cluster=true;
        rank=same;
        // Go figure!
        labelloc = "t";
        labeljust = "l";
        label="
        Black arrows are an \"is a\" relationship.
        {{uses|capitalize}} arrows are a \"uses\" relationship.
        {{contains|capitalize}} arrows are a \"contains a/some\" relationship.
        {{instance|capitalize}} arrows are an \"instance of\" relationship.
        ";
        cal [label="Instrument\nCalibration Data", fillcolor="{{calibration}}", style=filled];
        sdp [label="Processed\nScience Data", fillcolor="{{science_data}}", style=filled];
        ebhkp [label="Processed\nEB HK Data", fillcolor="{{processed_eb_hk}}", style=filled];
        obhkp [label="Processed\nOB HK Data", fillcolor="{{processed_ob_hk}}", style=filled];
        ebraw [label="Raw EB\nTM data", fillcolor="{{raw_eb}}", style=filled];
        obraw [label="Raw OB\nTM data", fillcolor="{{raw_ob}}", style=filled];

        // This is horrible, but the easiest way of placing the key is
        // to link one of its nodes to another node in the graph with
        // an invisible edge.
        cal -> ScienceDataSet [style=invis];
    }
}
